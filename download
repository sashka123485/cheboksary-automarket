let token=localStorage.token,user=null;
const $=id=>document.getElementById(id), money=n=>new Intl.NumberFormat("ru-RU").format(n)+" ₽";
async function api(url,opt={}){opt.headers={...(opt.headers||{}),...(token?{Authorization:"Bearer "+token}:{})};if(opt.body&&typeof opt.body!="string"){opt.headers["Content-Type"]="application/json";opt.body=JSON.stringify(opt.body)}let r=await fetch(url,opt),d=await r.json();if(!r.ok)throw Error(d.error||"Ошибка");return d}
async function register(){try{let d=await api("/api/register",{method:"POST",body:{username:$("u").value,password:$("p").value}});token=d.token;localStorage.token=token;await start()}catch(e){alert(e.message)}}
async function login(){try{let d=await api("/api/login",{method:"POST",body:{username:$("u").value,password:$("p").value}});token=d.token;localStorage.token=token;await start()}catch(e){alert(e.message)}}
async function start(){try{user=await api("/api/me");$("auth").hidden=true;$("app").hidden=false;$("adminBtn").hidden=!user.admin;update();loadMarket();loadGarage();loadShop();profile()}catch(e){localStorage.removeItem("token");token=null}}
function update(){ $("money").textContent=money(user.money) }
function show(x){document.querySelectorAll(".page").forEach(p=>p.hidden=true);$(x).hidden=false;if(x==="admin")loadAdmin()}
async function loadMarket(){let a=await api("/api/cars");$("cars").innerHTML=a.map(c=>`<div class="card"><div class="car">🚗</div><h2>${c.brand} ${c.model}</h2><p class=muted>${c.year} · ${c.mileage.toLocaleString()} км · продавец ${c.seller}</p><div class=price>${money(c.price)}</div><button class=main onclick="buy(${c.id})">Купить</button></div>`).join("")||"<div class=panel>Пока объявлений нет.</div>"}
async function buy(id){try{await api("/api/cars/"+id+"/buy",{method:"POST"});user=await api("/api/me");update();loadMarket();loadGarage();alert("Машина куплена!") }catch(e){alert(e.message)}}
async function loadGarage(){let a=await api("/api/my-cars"),g=await api("/api/garages");$("mycars").innerHTML=a.map(c=>`<div class=card><div class=car>🏎️</div><h2>${c.brand} ${c.model}</h2><p>${c.year} · ${c.mileage} км</p>${c.listed?`<button onclick="unlist(${c.id})">Снять с продажи</button>`:`<input id=p${c.id} type=number placeholder="Цена в ₽"><button class=main onclick="listCar(${c.id})">Продать игрокам</button>`}</div>`).join("");$("garages").innerHTML=g.map(x=>`<div class=card><h2>${x.name}</h2><p>${x.slots} мест</p><div class=price>${money(x.price)}</div><button onclick="garage(${x.slots})">Купить</button></div>`).join("")}
async function listCar(id){let v=Number($("p"+id).value);if(!v)return alert("Укажите цену");try{await api("/api/cars/"+id+"/list",{method:"POST",body:{price:v}});loadGarage();loadMarket()}catch(e){alert(e.message)}}
async function unlist(id){await api("/api/cars/"+id+"/unlist",{method:"POST"});loadGarage();loadMarket()}
async function garage(slots){try{await api("/api/garage/buy",{method:"POST",body:{slots}});user=await api("/api/me");update();loadGarage()}catch(e){alert(e.message)}}
async function loadShop(){let x=await api("/api/items");$("items").innerHTML=Object.entries(x).map(([k,v])=>`<div class=card><h2>${v.name}</h2><p class=price>${money(v.price)}</p><button class=main onclick="item('${k}')">Купить</button></div>`).join("")}
async function item(k){try{await api("/api/items/buy",{method:"POST",body:{item:k}});user=await api("/api/me");update();alert("Предмет получен")}catch(e){alert(e.message)}}
async function profile(){user=await api("/api/me");$("prof").innerHTML=`<h2>${user.username}</h2><p>Баланс: <b>${money(user.money)}</b></p><p>Мест в гараже: ${user.garage}</p><p>Предметов: ${user.inventory.length}</p><p>Город: Чебоксары</p>`}
async function loadAdmin(){let a=await api("/api/admin/users");$("users").innerHTML=a.map(u=>`<div class=card><h3>#${u.id} ${u.username}</h3><p>Баланс: ${money(u.money)} · гараж: ${u.garage}</p><input id=m${u.id} type=number placeholder="Сумма"><button onclick="giveM(${u.id})">Выдать деньги</button><select id=i${u.id}><option value=chips>Чипсы с крабом и сметаной</option><option value=radio>Магнитола</option><option value=apartment>Квартира в центре Чебоксар</option></select><button onclick="giveI(${u.id})">Выдать предмет</button></div>`).join("")}
async function giveM(id){await api("/api/admin/give-money",{method:"POST",body:{userId:id,amount:Number($("m"+id).value)}});loadAdmin()}
async function giveI(id){await api("/api/admin/give-item",{method:"POST",body:{userId:id,item:$("i"+id).value}});loadAdmin()}
if(token)start();io().on("market:update",loadMarket);